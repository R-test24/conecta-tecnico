# Configuração pública do SDK Web do Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcional. Chave longa e aleatória para o painel administrativo local.
ADMIN_DEMO_SECRET=

# Opcional. Usa Firebase Auth e Firestore locais no npm run dev.
NEXT_PUBLIC_FIREBASE_EMULATORS=false
